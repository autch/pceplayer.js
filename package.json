{
  "name": "pceplayer",
  "version": "2.0.0",
  "description": "P/ECE 標準音楽ドライバのデータ (pmd) を Web ブラウザで再生する",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Autch",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --mode card",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "gen-list": "node tools/gen-list.ts",
    "dev-data": "node scripts/dev-data.mjs",
    "update-muslib": "node scripts/update-muslib.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
